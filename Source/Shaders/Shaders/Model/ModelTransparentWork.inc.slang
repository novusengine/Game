#ifndef MODEL_TRANSPARENT_WORK_INCLUDED
#define MODEL_TRANSPARENT_WORK_INCLUDED

#include "Material/MaterialShared.inc.slang"

#define MODEL_INSTANCE_VISIBLE (1u << 0u)
#define MODEL_INSTANCE_FORCE_TRANSPARENT (1u << 7u)
#define MODEL_LOD_HAS_SKINNING (1u << 0u)
#define MODEL_LOD_STATIC_FALLBACK_IS_BIND_POSE (1u << 1u)
#define MODEL_CHUNK_MESHLET_COUNT 32u
#define MODEL_MESH_DISPATCH_MAX_GROUPS_X 1024u

#define MODEL_TRANSPARENT_BIN_COUNT 20u
#define MODEL_TRANSPARENT_DISPATCH_ARGUMENT_COUNT 3u
#define MODEL_TRANSPARENT_COUNT_MASK 0x3Fu
#define MODEL_TRANSPARENT_LOD_SHIFT 6u
#define MODEL_TRANSPARENT_LOD_MASK 0x7u

#define MODEL_TRANSPARENT_STAT_TESTED_INSTANCES 0u
#define MODEL_TRANSPARENT_STAT_REJECTED_INSTANCES 1u
#define MODEL_TRANSPARENT_STAT_EXPANDED_CHUNKS 2u
#define MODEL_TRANSPARENT_STAT_TESTED_MESHLETS 3u
#define MODEL_TRANSPARENT_STAT_REJECTED_FRUSTUM_MESHLETS 4u
#define MODEL_TRANSPARENT_STAT_REJECTED_CONE_MESHLETS 5u
#define MODEL_TRANSPARENT_STAT_REJECTED_OCCLUSION_MESHLETS 6u
#define MODEL_TRANSPARENT_STAT_REJECTED_GEOMETRY_GROUP_MESHLETS 7u
#define MODEL_TRANSPARENT_STAT_CHUNK_QUEUE_OVERFLOWS 8u
#define MODEL_TRANSPARENT_STAT_QUEUE_OVERFLOWS 9u
#define MODEL_TRANSPARENT_STAT_VISIBILITY_RECORD_PACKING_FAILURES 10u
#define MODEL_TRANSPARENT_STAT_TESTED_TRIANGLES 11u
#define MODEL_TRANSPARENT_STAT_COMMITTED_TRIANGLES 12u
#define MODEL_TRANSPARENT_STAT_QUEUE_COUNTS 13u
#define MODEL_TRANSPARENT_STAT_COUNT (MODEL_TRANSPARENT_STAT_QUEUE_COUNTS + MODEL_TRANSPARENT_BIN_COUNT)

struct ModelTransparentChunk
{
    uint instanceIndex;
    uint meshIndex;
    uint meshletBase;
    uint packedCountAndLOD;
    uint submeshIndex;
    uint binIndex;
    uint reserved0;
    uint reserved1;
};

uint ModelTransparentBin(uint executionGroup, bool twoSided)
{
    uint family = executionGroup / MATERIAL_EXECUTION_GROUP_CLASS_COUNT;
    uint layered = (executionGroup % MATERIAL_EXECUTION_GROUP_CLASS_COUNT) == 5u ? 1u : 0u;
    return family * 4u + layered * 2u + uint(twoSided);
}

#endif
