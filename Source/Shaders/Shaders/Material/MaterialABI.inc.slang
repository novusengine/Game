#ifndef MATERIAL_ABI_INCLUDED
#define MATERIAL_ABI_INCLUDED

#define MATERIAL_ABI_VERSION 1u
#define MATERIAL_EXECUTION_GROUP_CLASS_COUNT 6u
#define MATERIAL_MAX_PROGRAM_FAMILIES 5u
#define MATERIAL_EXECUTION_GROUP_COUNT (MATERIAL_EXECUTION_GROUP_CLASS_COUNT * MATERIAL_MAX_PROGRAM_FAMILIES)
#define MATERIAL_RESOLVE_GROUPS_PER_FAMILY 2u
#define MATERIAL_MODEL_RESOLVE_GROUP_COUNT (MATERIAL_MAX_PROGRAM_FAMILIES * MATERIAL_RESOLVE_GROUPS_PER_FAMILY)

uint MaterialResolveGroup(uint executionGroup)
{
    uint family = executionGroup / MATERIAL_EXECUTION_GROUP_CLASS_COUNT;
    uint groupClass = executionGroup % MATERIAL_EXECUTION_GROUP_CLASS_COUNT;
    return family * MATERIAL_RESOLVE_GROUPS_PER_FAMILY + (groupClass & 1u);
}
#define MATERIAL_INVALID_HANDLE 0xFFFFu
#define MATERIAL_INSTANCE_HAS_TEXTURE_TRANSFORMS (1u << 4u)
#define MATERIAL_TEXTURE_TRANSFORM_OFFSET 64u
#define MATERIAL_TEXTURE_TRANSFORM_STRIDE 48u
#define MATERIAL_TEXTURE_TRANSLATION_OFFSET 0u
#define MATERIAL_TEXTURE_ROTATION_OFFSET 16u
#define MATERIAL_TEXTURE_SCALE_OFFSET 32u

#endif
