export type vec = vector

declare vec :
{
    New : ((x : number, y : number, z : number?) -> vec),
}

declare extern type Engine with
    Name : string
    Version : vec
end
declare Engine : Engine

-- C++ u64 values preserve their full bit pattern; values with bit 63 set are represented as negative Luau integers.

declare INVALID_UNIT_ID : integer

declare extern type GameEvent with
    Invalid                 : integer
    Loaded                  : integer
    Updated                 : integer
    CharacterListChanged    : integer
    MapLoading              : integer
    MapLoaded               : integer
    MapLoadFailed           : integer
    ChatMessageReceived     : integer
    LocalMoverChanged       : integer
    CombatLog               : integer
    Count                   : integer
end
declare GameEvent : GameEvent

declare extern type UnitEvent with
    Invalid             : integer
    Add                 : integer
    Remove              : integer
    TargetChanged       : integer
    PowerUpdate         : integer
    ResistanceUpdate    : integer
    StatUpdate          : integer
    ReactionChanged     : integer
    AuraAdd             : integer
    AuraUpdate          : integer
    AuraRemove          : integer
    Count               : integer
end
declare UnitEvent : UnitEvent

declare extern type ContainerEvent with
    Invalid         : integer
    Add             : integer
    AddToSlot       : integer
    RemoveFromSlot  : integer
    SwapSlots       : integer
    Count           : integer
end
declare ContainerEvent : ContainerEvent

declare extern type TriggerEvent with
    Invalid         : integer
    OnEnter         : integer
    OnExit          : integer
    OnStay          : integer
    Count           : integer
end
