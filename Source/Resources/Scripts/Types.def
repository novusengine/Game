export type Event = integer

declare extern type GameEventDataMapLoaded with
    mapID : number
    mapInternalName : string
    isLoaded : boolean
end

declare extern type GameEventDataMapLoadFailed with
    mapID : number
    mapInternalName : string
    reason : string
end

