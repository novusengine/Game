end
declare extern type CharacterList with
    [number] : CharacterInfo
end

declare function RegisterEvent(eventID : Event, callback : ((eventID : Event, data : any) -> any)) : ()
declare Game : {
    IsLoaded : () -> boolean,
}
declare Scheduler : {
    AfterSeconds : (seconds : number, callback : () -> ()) -> number,
    AfterFrames : (frames : number, callback : () -> ()) -> number,
    Cancel : (handle : number) -> boolean,
}
declare function AddCursor(name : string, texture : string) : ()
declare function SetCursor(name : string) : boolean
type MapInfo = {
    id : integer,
    internalName : string,
    name : string,
    flags : integer,
    instanceType : integer,
    expansionID : integer,
    maxPlayers : integer,
}

declare Map : {
    GetCurrent : () -> string,
    GetLoadingProgress : () -> number,
    GetList : () -> { MapInfo },
    Load : (internalName : string) -> boolean,
    LoadByID : (id : integer) -> boolean,
    Unload : () -> boolean,
    SetOnCurrentMapChanged : (fn : (() -> ())?) -> (),
}
declare RenderTarget : {
    Dump : (debugName : string, artifactPath : string) -> (boolean, string),
}
declare RenderDoc : {
    IsAvailable : () -> boolean,
    CaptureNextFrame : (artifactPath : string) -> (boolean, string),
}
declare Tracy : {
    IsConnected : () -> boolean,
    Message : (message : string) -> (),
}
declare function EquipItem(itemID : integer, slotIndex : integer) : boolean
declare function UnEquipItem(slotIndex : integer) : boolean
declare function GetEquippedItem(slotIndex : integer) : integer
declare function ExecCmd(command : string) : boolean
declare function SendChatMessage(message : string) : ()
declare function IsOfflineMode() : boolean
declare function IsOnline() : boolean
declare function GetAuthStage() : integer
declare function IsInWorld() : boolean
declare function GetAccountName() : string
declare function Login(accountName : string, password : string, rememberMe : boolean) : boolean
declare function Logout() : boolean
declare function Disconnect() : boolean
declare function GetCharacterList() : CharacterList
declare function SelectCharacter(index : integer) : boolean
declare function GetMapName(mapID : integer) : string

declare extern type UIInputEvent with
    Invalid        : integer
    MouseDown      : integer
    MouseUp        : integer
    MouseHeld      : integer
    MouseScroll    : integer

    HoverBegin     : integer
    HoverEnd       : integer
    HoverHeld      : integer

    FocusBegin     : integer
    FocusEnd       : integer
    FocusHeld      : integer
end
declare UIInputEvent : UIInputEvent;

declare extern type UIKeyboardEvent with
    Invalid : integer
    Key     : integer
    Unicode : integer
end
declare UIKeyboardEvent : UIKeyboardEvent;

declare extern type InputPhase with
    Pressed  : integer
    Repeated : integer
    Released : integer
    Canceled : integer
    Triggered : integer
end
declare InputPhase : InputPhase;

declare extern type InputReply with
    Ignored  : integer
    Handled  : integer
    Consumed : integer
end
declare InputReply : InputReply;

declare extern type GameInputPriority with
    ImGui    : integer
    Modal    : integer
    UI       : integer
    Editor   : integer
    Camera   : integer
    Global   : integer
    Gameplay : integer
    Debug    : integer
end
declare GameInputPriority : GameInputPriority;

declare extern type InputModifier with
    None    : integer
    Shift   : integer
    Control : integer
    Alt     : integer
    Super   : integer
end
declare InputModifier : InputModifier;

declare extern type InputDevice with
    Keyboard : integer
    Mouse    : integer
    MouseWheel : integer
end
declare InputDevice : InputDevice;

declare extern type MouseWheelDirection with
    Up    : integer
    Down  : integer
    Left  : integer
    Right : integer
end
declare MouseWheelDirection : MouseWheelDirection;

declare extern type InputModifierMatch with
    Exact   : integer
    AtLeast : integer
    Any     : integer
end
declare InputModifierMatch : InputModifierMatch;

declare extern type InputBindingConflictPolicy with
    Reject  : integer
    Replace : integer
    Swap    : integer
    Allow   : integer
end
declare InputBindingConflictPolicy : InputBindingConflictPolicy;

declare extern type InputBindingConflictKind with
    Direct              : integer
    ShadowsRequested    : integer
    ShadowedByRequested : integer
end
declare InputBindingConflictKind : InputBindingConflictKind;

declare extern type InputBindingChangeStatus with
    Applied              : integer
    AppliedWithConflicts : integer
    Queued               : integer
    RejectedConflict     : integer
    InvalidAction        : integer
    InvalidSlot          : integer
    InvalidBinding       : integer
    InvalidPolicy        : integer
    NotRebindable        : integer
end
declare InputBindingChangeStatus : InputBindingChangeStatus;

type MouseEventCallback = ((event : UIInputEvent, widget : Widget, ...any) -> ())
type KeyboardEventCallback = ((widget : Widget, event : UIKeyboardEvent, ...any) -> boolean)

declare extern type WidgetInputEvents with
    function SetOnMouseDown(self, callback : MouseEventCallback?) : ()
    function SetOnMouseUp(self, callback : MouseEventCallback?) : ()
    function SetOnMouseHeld(self, callback : MouseEventCallback?) : ()
    function SetOnMouseScroll(self, callback : MouseEventCallback?) : ()

    function SetOnHoverBegin(self, callback : MouseEventCallback?) : ()
    function SetOnHoverEnd(self, callback : MouseEventCallback?) : ()
    function SetOnHoverHeld(self, callback : MouseEventCallback?) : ()

    function SetOnFocusBegin(self, callback : MouseEventCallback?) : ()
    function SetOnFocusEnd(self, callback : MouseEventCallback?) : ()
    function SetOnFocusHeld(self, callback : MouseEventCallback?) : ()

    function SetOnKeyboard(self, callback : KeyboardEventCallback?) : ()
end

declare extern type Widget extends WidgetInputEvents with
    function NewWidget(self, position : vec, layer : integer) : Widget
    function NewPanel(self, position : vec, size : vec, layer : integer, template : string?) : Panel
    function NewText(self, text : string, position : vec, layer : integer, template : string) : TextWidget

    function SetEnabled(self, enabled : boolean) : ()
    function SetVisible(self, visible : boolean) : ()
    function SetInteractable(self, interactable : boolean) : ()
    function SetFocusable(self, focusable : boolean) : ()

    function IsEnabled(self) : boolean
    function IsVisible(self) : boolean
    function IsInteractable(self) : boolean
    function IsFocusable(self) : boolean

    function GetParent(self) : Widget?
    function GetChildren(self) : { Widget }
    function GetChildrenRecursive(self) : { Widget }

    function GetAnchor(self) : vec
    function GetRelativePoint(self) : vec
    function SetAnchor(self, anchor : vec) : ()
    function SetRelativePoint(self, point : vec) : ()

    function IsClipChildren(self) : boolean
    function SetClipChildren(self, clipChildren : boolean) : ()
    function GetClipRect(self) : (vec, vec)
    function SetClipRect(self, min : vec, max : vec) : ()
    function GetClipMaskTexture(self) : string?
    function SetClipMaskTexture(self, texturePath : string?) : ()

    function GetPos(self) : vec
    function GetPosX(self) : number
    function GetPosY(self) : number
    function SetPos(self, position : vec) : ()
    function SetPosX(self, x : number) : ()
    function SetPosY(self, y : number) : ()

    function GetWorldPos(self) : vec
    function GetWorldPosX(self) : number
    function GetWorldPosY(self) : number
    function SetWorldPos(self, position : vec) : ()
    function SetWorldPosX(self, x : number) : ()
    function SetWorldPosY(self, y : number) : ()

    function SetPos3D(self, pos : vec?) : ()
    function ForceRefresh(self) : ()
    function GetLayer(self) : integer
    function SetLayer(self, layer : integer) : ()
    function RegisterLayoutRefresh(self, callback : (() -> ())?) : ()
    function InvalidateLayout(self) : ()
end

declare extern type Canvas with
    function NewWidget(self, position : vec, layer : integer) : Widget
    function NewPanel(self, position : vec, size : vec, layer : integer, template : string?) : Panel
    function NewText(self, text : string, position : vec, layer : integer, template : string) : TextWidget
end

declare extern type Panel extends Widget with
    function GetSize(self) : vec
    function GetWidth(self) : number
    function GetHeight(self) : number
    function SetSize(self, size : vec) : ()
    function SetWidth(self, width : number) : ()
    function SetHeight(self, height : number) : ()

    function SetBackground(self, background : (string | Canvas)?) : ()
    function SetForeground(self, foreground : string?) : ()

    function SetTexCoords(self, min : vec, max : vec) : ()
    function SetColor(self, color : vec, alpha : number?) : ()
    function SetAlpha(self, alpha : number) : ()
    function SetBorderColor(self, color : vec, alpha : number?) : ()
    function SetBorderSize(self, size : number) : ()
end

declare extern type TextWidget extends Widget with
    function GetText(self) : string
    function SetText(self, text : string) : ()
    function GetRawText(self) : string
    function GetSize(self) : vec
    function GetFontSize(self) : number
    function SetFontSize(self, size : number) : ()
    function GetWidth(self) : number
    function GetHeight(self) : number
    function GetColor(self) : vec
    function SetColor(self, color : vec) : ()
    function SetAlpha(self, alpha : number) : ()
    function GetWrapWidth(self) : number
    function SetWrapWidth(self, width : number) : ()
    function GetWrapIndent(self) : integer
    function SetWrapIndent(self, size : integer) : ()
end

declare extern type EventTemplate with
    onMouseDown : MouseEventCallback?
    onMouseUp : MouseEventCallback?
    onMouseHeld : MouseEventCallback?

    onHoverBegin : MouseEventCallback?
    onHoverEnd : MouseEventCallback?
    onHoverHeld : MouseEventCallback?

    onFocusBegin : MouseEventCallback?
    onFocusEnd : MouseEventCallback?
    onFocusHeld : MouseEventCallback?
end

declare extern type PanelTemplate extends EventTemplate with
    background : string?
    foreground : string?
    color : vec?
    alpha : number?
    cornerRadius : number?
    borderColor : vec?
    borderSize : number?
    texCoords : Box?
    nineSliceInsets : Box? -- Source pixels ordered left, top, right, bottom.
    onClickTemplate : string?
    onHoverTemplate : string?
    onUninteractableTemplate : string?

    EventTemplate : EventTemplate?
end

declare extern type TextTemplate extends EventTemplate with
    font : string?
    size : number?
    color : vec?
    borderSize : number?
    borderColor : vec?
    wrapWidth : number?
    wrapIndent : integer?

    EventTemplate : EventTemplate?
end

type SendMessageToChatCallback = ((channel : string, playerName : string, text : string, isOutgoing : boolean) -> ())

declare UI :
{
    RegisterPanelTemplate : ((name : string, template : PanelTemplate) -> ()),
    RegisterTextTemplate : ((name : string, template : TextTemplate) -> ()),

    RegisterSendMessageToChatCallback : ((callback : SendMessageToChatCallback?) -> ()),

    GetCanvas : ((name : string, position : vec, size : vec, isRenderTexture : boolean?) -> Canvas),
    GetMousePos : (() -> vec),
    GetTextureSize : ((path : string) -> vec?),
    IsSmoothUnitFrameBarsEnabled : (() -> boolean),

    PixelsToTexCoord : ((position : vec, size : vec) -> vec),
    CalculateTextSize : ((text : string, template : string) -> vec),
    WrapText : ((text : string, template : string, wrapWidth : number) -> (string, vec)),

    FocusWidget : ((widget : Widget) -> ()),
    UnfocusWidget : ((widget : Widget) -> ()),
    IsFocusedWidget : ((widget : Widget) -> boolean),
    WasJustFocusedWidget : ((widget : Widget) -> boolean),
    GetFocusedWidget : (() -> Widget?),

    IsHoveredWidget : ((widget : Widget) -> boolean),

    DestroyWidget : ((widget : Widget) -> ()),
}

declare Input :
{
    RegisterAction : ((name : string, displayName : string, category : string, binding : { [string] : any }, options : { [string] : any }?) -> boolean),
    Connect : ((name : string, callback : (phase : integer, device : integer, code : integer, modifiers : integer, value : number) -> integer) -> integer),
    Disconnect : ((connection : integer) -> boolean),
    SetBinding : ((name : string, slot : integer, binding : { [string] : any }, policy : integer?) -> { [any] : any }),
    ClearBinding : ((name : string, slot : integer, policy : integer?) -> { [any] : any }),
    ResetBinding : ((name : string, slot : integer, policy : integer?) -> { [any] : any }),
    GetBinding : ((name : string, slot : integer) -> { [string] : any }?),
    GetActions : (() -> { any }),
    IsDown : ((name : string) -> boolean),
    WasPressed : ((name : string) -> boolean),
    WasReleased : ((name : string) -> boolean),
    FindBindingConflicts : ((name : string, slot : integer, binding : { [string] : any }) -> { [any] : any }),
    BeginBindingCapture : ((callback : (binding : { [string] : any }?) -> ()) -> boolean),
    CancelBindingCapture : (() -> boolean),
    IsBindingCaptureActive : (() -> boolean),
    SaveBindings : (() -> boolean),
    CreateContext : ((name : string, priority : integer, sortOrder : integer?) -> boolean),
    SetContextActive : ((name : string, active : boolean) -> boolean),
    IsContextActive : ((name : string) -> boolean),
    GetContexts : (() -> { any }),
    IsMouseCaptured : (() -> boolean),
    IsSoftwareCursorEnabled : (() -> boolean),
    GetCursorState : ((knownRevision : integer?) -> (integer?, string?)),
}

