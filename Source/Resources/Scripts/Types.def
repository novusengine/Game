declare SpellEditor :
{
    GetSnapshot : (() -> { [string] : any }),
    GetDraft : (() -> { [string] : any }?),
    GetCatalog : (() -> { [string] : any }),
    SearchIcons : ((filter : string, offset : integer, limit : integer) -> { [string] : any }),
    RequestSnapshot : (() -> boolean),
    OpenDraft : ((spellID : integer) -> boolean),
    CreateDraft : (() -> boolean),
    DuplicateDraft : ((spellID : integer) -> boolean),
    DiscardDraft : (() -> ()),
    SetField : ((field : string, value : string | number | integer) -> boolean),
    SetAuraEnabled : ((enabled : boolean) -> boolean),
    SetAuraField : ((field : string, value : number | integer) -> boolean),
    AddEffect : ((effectType : integer) -> integer),
    RemoveEffect : ((effectID : integer) -> boolean),
    MoveEffect : ((effectID : integer, offset : integer) -> boolean),
    SetEffectField : ((effectID : integer, field : string, value : integer) -> boolean),
    SetEffectParameter : ((effectID : integer, parameterIndex : integer, value : integer) -> boolean),
    AddConstraint : ((groupID : integer) -> integer),
    RemoveConstraint : ((constraintID : integer) -> boolean),
    SetConstraintField : ((constraintID : integer, field : string, value : integer) -> boolean),
    ResetConstraintField : ((constraintID : integer, field : string) -> boolean),
    CreateConstraintGroup : ((name : string, defaultScope : integer, defaultMaximumApplications : integer, defaultOverflowBehavior : integer) -> integer),
    UpdateConstraintGroup : ((groupID : integer, name : string, defaultScope : integer, defaultMaximumApplications : integer, defaultOverflowBehavior : integer) -> boolean),
    DeleteConstraintGroup : ((groupID : integer) -> boolean),
    CreateProcData : ((ownerSpellID : integer, name : string, phaseMask : integer, typeMask : integer, hitMask : integer, flags : integer, procsPerMinute : number, chanceToProc : number, internalCooldownMS : integer, charges : integer) -> integer),
    UpdateProcData : ((procDataID : integer, ownerSpellID : integer, name : string, phaseMask : integer, typeMask : integer, hitMask : integer, flags : integer, procsPerMinute : number, chanceToProc : number, internalCooldownMS : integer, charges : integer) -> boolean),
    DeleteProcData : ((procDataID : integer) -> boolean),
    AddProcLink : ((procDataID : integer) -> integer),
    RemoveProcLink : ((procLinkID : integer) -> boolean),
    SetProcLinkData : ((procLinkID : integer, procDataID : integer) -> boolean),
    SetProcLinkEffect : ((procLinkID : integer, effectID : integer, selected : boolean) -> boolean),
    Validate : (() -> { { path : string, message : string } }),
    Submit : (() -> boolean),
    Delete : ((spellID : integer) -> boolean),
}

